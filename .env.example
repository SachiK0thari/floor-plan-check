# Copy to .env and fill in. .env is never committed.

# Path to the CubiCasa5K dataset. The author downloads it (CC BY-NC 4.0); see docs/data_sources.md.
CUBICASA5K_DIR=

# Postgres + pgvector (docker-compose.yml). Used from milestone M6.
POSTGRES_USER=plancheck
POSTGRES_PASSWORD=
POSTGRES_DB=plancheck
POSTGRES_PORT=5432
