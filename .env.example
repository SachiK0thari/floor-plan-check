# Copy to .env and fill in. .env is never committed.

# Path to the CubiCasa5K dataset. The author downloads it (CC BY-NC 4.0); see docs/data_sources.md.
CUBICASA5K_DIR=

# Postgres + pgvector (docker-compose.yml). Used from milestone M6.
POSTGRES_USER=plancheck
POSTGRES_PASSWORD=
POSTGRES_DB=plancheck
POSTGRES_PORT=5432

# Plain-language explanations of findings (configs/explain.yaml). Optional; without it
# explanations are off. Finding data, with no drawing text, is sent to OpenRouter only
# when the user asks for explanations.
OPENROUTER_API_KEY=
